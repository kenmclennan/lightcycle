{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Callout response (protocol 2)",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "enum": ["ok", "failed"] },
    "message": { "type": "string" },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["message", "fix"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "fix": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["cost_usd"],
      "properties": {
        "cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["label", "kind", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["link", "text", "markdown"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }
      }
    }
  },
  "if": { "properties": { "status": { "const": "failed" } } },
  "then": {
    "anyOf": [
      { "required": ["message"], "properties": { "message": { "minLength": 1 } } },
      { "required": ["errors"], "properties": { "errors": { "minItems": 1 } } }
    ]
  },
  "else": { "properties": { "errors": { "maxItems": 0 } } }
}
